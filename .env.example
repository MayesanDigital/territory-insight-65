# =============================================================================
# Territorio Intelligence — plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA versiones el .env real.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — expuesto al navegador (prefijo VITE_)
# La publishable key está diseñada para ser pública; RLS es lo que protege los
# datos. Aun así, no la reutilices entre entornos.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<tu-proyecto>"

# -----------------------------------------------------------------------------
# Supabase — solo servidor (SSR y server functions). Sin prefijo VITE_, así que
# Vite no los inyecta en el bundle del cliente.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://<tu-proyecto>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<tu-proyecto>"

# SECRETO. Salta RLS por completo. Solo en variables de entorno del servidor
# (Vercel: scope "Production/Preview", nunca en el cliente). Si se filtra,
# rótala de inmediato desde el dashboard de Supabase.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Mapas
# El mapa usa teselas de CARTO/OpenStreetMap y no requiere token. Rellena esto
# solo si activas la capa satelital de Mapbox.
# -----------------------------------------------------------------------------
VITE_MAPBOX_TOKEN=""

# -----------------------------------------------------------------------------
# Monitoreo público
# El pipeline de ingesta corre como Edge Function de Supabase sobre feeds RSS
# registrados en la tabla web_sources. MONITORING_INGEST_SECRET protege el
# endpoint de ingesta para que solo el scheduler pueda dispararlo.
# -----------------------------------------------------------------------------
MONITORING_INGEST_SECRET=""
# Identifica al crawler ante los sitios que visita, como pide la buena práctica
# de robots.txt. Usa un correo o URL de contacto reales.
MONITORING_USER_AGENT="TerritorioIntelligenceBot/1.0 (+mailto:contacto@ejemplo.mx)"
